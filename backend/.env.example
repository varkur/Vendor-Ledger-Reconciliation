# ─── Application ───
APP_NAME=Enterprise FastAPI
APP_VERSION=1.0.0
DEBUG=false

# ─── Database ───
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/enterprise_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ─── JWT Authentication ───
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Logging ───
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/application.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0

# ─── Celery ───
CELERY_BROKER_URL=redis://localhost:6379/1

# ─── OpenTelemetry ───
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=enterprise-api

# ─── Azure AD / Microsoft SSO ───
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_REDIRECT_URI=http://localhost:3000/oauth/v2/callback

# ─── CORS ───
CORS_ORIGINS=["http://localhost:3000"]

# ─── Encryption (SAP credentials) ───
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── Employee Ad Service ───
EMPLOYEE_AD_BASE_URL=https://ad-prod-darwinsvc-prod.apps.emart.oneemcure.local/rest-doc/adintegratorservices/rest/v1 